#!/usr/bin/env bash
# nexus — launcher for persona containers. ./config.sh sets up the personas and links this script,
# e.g. to /usr/local/bin/nexus.
#
#   nexus <persona> [session] [-- cmd ...]   attach to (or create) a tmux session in that persona,
#                                            named after $PWD unless given; cmd runs only on create
#   nexus ls                                 a table of every persona and its state; one of the sessions of
#                                            the running ones
#   nexus top [-n SECONDS] [--once]          live view of every persona: CPU, memory and, per Claude Code
#                                            session, context, 5h/7d limits and cost (q quits)
#   nexus <persona> ls                       a table of that persona's sessions
#   nexus <persona> stop|logs|build|pull [args]
#                                            args go to compose, e.g. build --no-cache
#   nexus <persona> headless [PROMPT] [FLAGS…]
#                                            one prompt, no tmux: claude -p or grok -p with FLAGS, in this
#                                            dir; piped input goes with the prompt; output and exit code are its
#   nexus <persona> start                    start it if it isn't running, without attaching (scripts, cron)
#   nexus <persona> restart                  recreate the container: picks up a rebuilt/pulled image
#   nexus <persona> upgrade [VERSION|CHANNEL] [-y]
#                                            pin its CLI (claude or grok) to VERSION, else to the newest
#                                            release (of CHANNEL), build or pull the images, recreate every
#                                            persona of that flavour (asks first; -y doesn't), drop the old ones
#
# Examples, with personas named claude-ddev and grok-docker (the names config.sh suggests):
#   cd ~/projects/billing && nexus claude-ddev            # session "billing", shell at that dir
#   nexus claude-ddev review -- claude --resume           # new session "review", straight into Claude Code
#   nexus grok-docker                                     # same project, other persona
#   git diff | nexus claude-ddev headless "review it"     # the review on stdout, no session
#   nexus claude-ddev upgrade                             # the newest Claude Code, for every Claude persona
set -euo pipefail

die()   { echo "nexus: $*" >&2; exit 1; }
warn()  { echo "nexus: warning: $*" >&2; }
usage() { awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; }

[[ $# -ge 1 ]] || { usage; exit 1; }
[[ "$1" == -h || "$1" == --help ]] && { usage; exit 0; }

# The repo this script lives in, found through the /usr/local/bin symlink.
AGENTS_DIR="${AGENTS_DIR:-$(dirname "$(readlink -f "$0")")}"
# Compose runs from the repo: in a shell whose directory was deleted it fails with "getwd: no such
# file or directory". A session's project dir still comes from $PWD, the path.
here="$PWD"
pwd -P >/dev/null 2>&1 || warn "this shell sits in a deleted directory; leave it, e.g. cd $(printf %q "$here")"
cd "$AGENTS_DIR" 2>/dev/null || die "can't cd to $AGENTS_DIR"
AGENTS_DIR="$PWD"
# The personas, written by config.sh. Its "# persona: <name> key=value …" lines are read here too.
PERSONAS_FILE="$AGENTS_DIR/compose.personas.yml"
# -p: an exported COMPOSE_PROJECT_NAME would otherwise switch to fresh, empty home volumes.
COMPOSE=(docker compose -p agents -f "$AGENTS_DIR/compose.yml" -f "$PERSONAS_FILE")

# Identity + daemon access, derived from the VM user running this. Exported, so they beat ./.env.
export AGENT_UID="${AGENT_UID:-$(id -u)}"
export AGENT_GID="${AGENT_GID:-$(id -g)}"
[[ -S /var/run/docker.sock ]] || die "no Docker socket at /var/run/docker.sock"
export DOCKER_GID="${DOCKER_GID:-$(stat -c %g /var/run/docker.sock)}"

# env_get KEY: KEY's value in ./.env as compose reads it: the last KEY= line, in the dotenv forms
# compose takes (export prefix, CRLF, '…', "…" with its escapes, trailing comment), but not ${VAR}
# references. config.sh's get_kv reads it the same way.
env_get() {
  [[ -f "$AGENTS_DIR/.env" ]] || return 0
  sed -nE "s/\r\$//; s/^[[:space:]]*(export[[:space:]]+)?$1[[:space:]]*=[[:space:]]*//p" "$AGENTS_DIR/.env" | tail -n 1 \
    | sed -E 's/^"((\\.|[^"\\])*)".*/\1/; t dq; s/^\x27((\\.|[^\x27\\])*)\x27.*/\1/; t sq; s/[[:space:]]+#.*//; s/[[:space:]]+$//; b
              :sq; s/\\\x27/\x27/g; b
              :dq; s/\\\\/\x01/g; s/\\n/\n/g; s/\\t/\t/g; s/\\r/\r/g; s/\\([$"])/\1/g; s/\x01/\\/g'
}
# env_set KEY VALUE: rewrite the KEY= line compose reads, else the first "# KEY=", else append one;
# config.sh's set_kv, for values that need no quoting. Written through, as config.sh writes .env: a
# symlinked .env keeps its link, and the file keeps its owner, mode and inode.
env_set() {
  local f="$AGENTS_DIR/.env" tmp
  tmp="$(mktemp "$f.XXXXXX")" || return 1
  if ! K="$1" L="$1=$2" awk 'BEGIN { k = ENVIRON["K"]; l = ENVIRON["L"] }
         { line[NR] = $0 }
         $0 ~ "^[ \t]*(export[ \t]+)?" k "[ \t]*=" { act = NR }
         !com && $0 ~ "^# ?" k "=" { com = NR }
         END { at = act ? act : com
               for (i = 1; i <= NR; i++) print (i == at ? l : line[i])
               if (!at) print l }' "$f" > "$tmp"; then
    rm -f "$tmp"; return 1
  fi
  if ! cat "$tmp" > "$f"; then warn "writing $f failed; what it should hold is in $tmp"; return 1; fi
  rm -f "$tmp"
}

# The VM's projects root: shell, else ./.env, else ~/projects. A persona with its own (root= in its
# "# persona:" line, set by config.sh) uses that instead. Compose gets it per call (COMPOSE, below) and
# this process's environment keeps the shell's value, so a nexus run from here works out its own.
vm_root="${PROJECTS_ROOT:-$(env_get PROJECTS_ROOT)}"
vm_root="${vm_root:-$HOME/projects}"

# SSH agent forwarding. Ubuntu/Debian user sessions usually have one of these.
if [[ ! -S "${SSH_AUTH_SOCK:-}" ]]; then
  SSH_AUTH_SOCK=""
  rt="${XDG_RUNTIME_DIR:-/run/user/$AGENT_UID}"
  for s in "/run/user/$AGENT_UID/ssh-agent.sock" "$rt/openssh_agent" "$rt/keyring/ssh" "/run/user/$AGENT_UID/gnupg/S.gpg-agent.ssh"; do
    [[ -S "$s" ]] && { SSH_AUTH_SOCK="$s"; break; }
  done
fi
export SSH_AUTH_SOCK   # empty = none found; compose.yml then says what to do

# Each flavour's CLI: its command, the .env pin its images are built from, the tag that follows the pin,
# its release channels (the first is the default) and the URL naming a channel's newest version.
# Another flavour is one more entry.
declare -A CLI_CMD=([claude]=claude [grok]=grok)
declare -A CLI_PIN=([claude]=CLAUDE_VERSION [grok]=GROK_VERSION)
declare -A CLI_TAG=([claude]=CLAUDE_TAG [grok]=GROK_TAG)
declare -A CLI_CHANNELS=([claude]="latest stable" [grok]="stable alpha")
declare -A CLI_NEWEST=([claude]="https://downloads.claude.ai/claude-code-releases/{channel}" [grok]="https://x.ai/cli/{channel}")

# --- tables: what ls and top print ---------------------------------------------------------------
# T_* are bold, dim, red, yellow, green and reset, set by set_colours on a terminal (not with NO_COLOR);
# T_EVERY is top's redraw interval, for its header.
T_B="" T_D="" T_R="" T_Y="" T_G="" T_0="" T_EVERY=""
set_colours() {
  if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    T_B=$'\033[1m' T_D=$'\033[90m' T_R=$'\033[31m' T_Y=$'\033[33m' T_G=$'\033[32m' T_0=$'\033[0m'
  fi
}
# t_plain VAR CELL: CELL without its T_* colours. t_clean VAR TEXT: TEXT as a cell, "-" if empty, without
# control characters: C0 and DEL, and C1 (U+0080-U+009F, which a terminal can take for ESC [ and the like),
# byte by byte, so in any locale. Their locals have names no caller uses: printf -v would write those.
t_plain() { local _tp="${2//$'\033['[0-9][0-9]m/}"; printf -v "$1" '%s' "${_tp//$'\033['[0-9]m/}"; }
t_clean() {
  local LC_ALL=C _tc
  _tc="${2//[[:cntrl:]]/}"; _tc="${_tc//$'\xc2'[$'\x80'-$'\x9f']/}"
  printf -v "$1" '%s' "${_tc:--}"
}

# table ALIGN ROW…: the ROWs as columns two spaces apart, the first (the header) dim. A ROW is its cells
# joined by tabs, none of them empty, so "-" for nothing; a cell may hold T_* colours, which take no room.
# ALIGN has an l or an r per column (left or right; l where it stops), and a last column on the left isn't
# padded. Cells are printed as they are: what a persona sent goes through t_clean first. Widths count
# characters, so a wide one (CJK, emoji) still shifts its row a little.
table() {
  local align="$1" r p pad line i last n=0
  local -a w=() f
  shift
  for r in "$@"; do
    IFS=$'\t' read -r -a f <<< "$r"
    for i in "${!f[@]}"; do t_plain p "${f[i]}"; (( ${#p} <= ${w[i]:-0} )) || w[i]=${#p}; done
  done
  for r in "$@"; do
    IFS=$'\t' read -r -a f <<< "$r"
    line="" last=$(( ${#f[@]} - 1 ))
    for i in "${!f[@]}"; do
      t_plain p "${f[i]}"
      printf -v pad '%*s' $(( w[i] - ${#p} )) ''
      if [[ "${align:i:1}" == r ]]; then line+="$pad${f[i]}"
      elif (( i == last )); then line+="${f[i]}"
      else line+="${f[i]}$pad"; fi
      (( i == last )) || line+="  "
    done
    if (( n++ )); then printf '%s\n' "$line"; else printf '%s\n' "$T_D$line$T_0"; fi
  done
}

# ps_states: STATE[container] for the persona containers on this VM (healthy, unhealthy, starting, running,
# stopped, …), found by name as every other command finds them; UP[container] for the running ones, and
# HERE[container] for those this checkout started (compose labels each with its directory): one docker ps.
declare -A STATE=() UP=() HERE=()
ps_states() {
  local c st sp wd
  STATE=() UP=() HERE=()
  while IFS=$'\t' read -r c st sp wd; do
    [[ "$wd" != "$AGENTS_DIR" ]] || HERE[$c]=1
    if [[ "$st" == running ]]; then
      UP[$c]=1
      case "$sp" in *"(healthy)"*) st=healthy ;; *"(unhealthy)"*) st=unhealthy ;; *"(health: starting)"*) st=starting ;; esac
    elif [[ "$st" == exited || "$st" == created || "$st" == dead ]]; then
      st=stopped
    fi
    STATE[$c]="$st"
  done < <(docker ps -a --filter label=agent.persona \
             --format '{{.Names}}\t{{.State}}\t{{.Status}}\t{{.Label "com.docker.compose.project.working_dir"}}')
}
state_colour() {  # state_colour VAR STATE: green when it runs, red unhealthy, yellow on the way, dim otherwise
  case "$2" in
    healthy|running)     printf -v "$1" '%s' "$T_G" ;;
    unhealthy)           printf -v "$1" '%s' "$T_R" ;;
    starting|restarting) printf -v "$1" '%s' "$T_Y" ;;
    *)                   printf -v "$1" '%s' "$T_D" ;;
  esac
}
# Run in a persona: a line per tmux session with its name, windows, attached clients and the dir of its
# current pane, each ended by \037. Each is asked for on its own, by the session's id, and its newlines,
# tabs and \037s flattened, so a name or a dir can't forge a line or a field. Exit 1: no tmux answer.
# shellcheck disable=SC2016  # expanded by sh inside the persona
SESS_PROBE='ids=$(tmux list-sessions -F "#{session_id}" 2>/dev/null) || exit 1
for id in $ids; do
  for f in session_name session_windows session_attached pane_current_path; do
    v=$(tmux display-message -p -t "$id" "#{$f}" 2>/dev/null); printf "%s" "$v" | tr "\n\t\037" "   "; printf "\037"
  done
  echo
done'
# sess_rows CONTAINER LEAD: a row for each tmux session in CONTAINER, appended to SROWS: LEAD (cells, each
# ending in a tab, or nothing), then session, windows, attached and the dir of its current pane. False,
# with a row saying so, if its tmux doesn't answer.
SROWS=()
sess_rows() {
  local out s w a d
  if ! out="$(timeout 10 docker exec "$1" sh -c "$SESS_PROBE" 2>/dev/null)"; then   # a hung persona can't hang this
    SROWS+=("$2-"$'\t'"-"$'\t'"-"$'\t'"tmux isn't answering"); return 1
  fi
  while IFS=$'\037' read -r s w a d _; do
    [[ -n "$s$w$a$d" ]] || continue
    t_clean s "$s"; t_clean d "$d"
    [[ "$w" =~ ^[0-9]+$ ]] || w=-
    if [[ "$a" =~ ^[1-9][0-9]*$ ]]; then a=yes; else a=no; fi
    SROWS+=("$2$s"$'\t'"$w"$'\t'"$a"$'\t'"$d")
  done <<< "$out"
}

# nexus ls: every persona set up here, with its flavour, context, ssh, state and projects root; the tmux
# sessions of the running ones; then any container of this checkout no persona has any more (compose
# labels each with its directory).
cmd_ls_all() {
  local name rest c st fl cx how root lc idle=0
  local -a rows=($'PERSONA\tFLAVOUR\tCONTEXT\tSSH\tSTATE\tPROJECTS ROOT') notes=()
  local -A known=()
  [[ -f "$PERSONAS_FILE" ]] || die "no personas set up yet: run $AGENTS_DIR/config.sh"
  set_colours; ps_states
  SROWS=($'PERSONA\tSESSION\tWINDOWS\tATTACHED\tDIR')
  while read -r name rest; do
    rest=" $rest " c="agent-$name"; known[$c]=1
    fl="${rest#* flavour=}"; fl="${fl%% *}"; cx="${rest#* context=}"; cx="${cx%% *}"
    case "$rest" in *" ssh=none "*) how=none ;; *" ssh="*) how="own key" ;; *) how=agent ;; esac
    root="$vm_root"; if [[ "$rest" == *" root="* ]]; then root="${rest#* root=}"; root="${root%% *}"; fi
    t_clean root "${root%/}"
    st="${STATE[$c]:-not started}"; state_colour lc "$st"
    rows+=("$name"$'\t'"$fl"$'\t'"$cx"$'\t'"$how"$'\t'"$lc$st$T_0"$'\t'"$root")
    if [[ -n "${UP[$c]:-}" ]]; then sess_rows "$c" "$name"$'\t' || true; else idle=1; fi
  done < <(sed -n 's/\r$//; s/^# persona: //p' "$PERSONAS_FILE")
  table lllll "${rows[@]}"
  if (( ${#SROWS[@]} > 1 )); then echo; table llrll "${SROWS[@]}"; fi
  if (( idle )); then notes+=("${T_D}nexus <persona> starts one that isn't running$T_0"); fi
  for c in $(printf '%s\n' "${!HERE[@]}" | sort); do
    [[ -n "${known[$c]:-}" ]] || notes+=("$c is ${STATE[$c]}, and no persona has it any more: docker rm -f $c removes it")
  done
  if (( ${#notes[@]} )); then echo; printf '%s\n' "${notes[@]}"; fi
}

# --- top -------------------------------------------------------------------------------------------
# Every persona at a glance, redrawn every few seconds: its container's state, CPU and memory, and each
# pane running its CLI. A pane in a persona with the statusline on comes with the model, context, 5-hour
# and 7-day limits and session cost: the CLI's statusline.sh (statusline/claude/ or statusline/grok/)
# saves them to ~/.cache/nexus/status/<pane> each time it draws, and SEEN is how long ago that was. grok sends no limits, and a cost only
# once something in the session has a price.

# Run in each running persona with its CLI as $1: the panes running it, typed into a shell or started
# with `-- <cli>`, each with its snapshot ("-" if none), tab-separated. tmux prints a tab as "_", but no
# session name holds a ":" (tmux rewrites it), so that splits its fields; the start command, last, may.
# shellcheck disable=SC2016  # expanded by sh inside the persona
TOP_PROBE='tmux list-panes -a -F "#{pane_id}:#{window_index}.#{pane_index}:#{pane_current_command}:#{session_name}:#{pane_start_command}" 2>/dev/null |
while IFS=: read -r id wp cur sess start; do
  [ "$cur" = "$1" ] || case "$start" in "$1"|"$1 "*|\""$1 "*) ;; *) continue ;; esac
  s=-; f="$HOME/.cache/nexus/status/${id#%}"
  [ -f "$f" ] && read -r s < "$f"
  printf "%s\t%s\t%s\t%s\n" "$id" "$wp" "$sess" "$s"
done'

top_tok() {   # top_tok VAR TOKENS: 640, 38k, 1.2M
  local n="$2" d
  if (( n >= 1000000 )); then
    d=$(( (n + 50000) / 100000 ))
    if (( d % 10 )); then printf -v "$1" '%d.%dM' $(( d / 10 )) $(( d % 10 )); else printf -v "$1" '%dM' $(( d / 10 )); fi
  elif (( n >= 1000 )); then printf -v "$1" '%dk' $(( (n + 500) / 1000 ))
  else printf -v "$1" '%d' "$n"; fi
}
top_age() {   # top_age VAR SECONDS: 12s, 3m, 2h, 4d
  local s=$(( $2 < 0 ? 0 : $2 ))
  if (( s < 60 )); then printf -v "$1" '%ds' "$s"
  elif (( s < 3600 )); then printf -v "$1" '%dm' $(( s / 60 ))
  elif (( s < 86400 )); then printf -v "$1" '%dh' $(( s / 3600 ))
  else printf -v "$1" '%dd' $(( s / 86400 )); fi
}
top_load() {  # top_load VAR PERCENT: the statusline's colour for it: green, yellow from 50, red from 80
  if [[ ! "$2" =~ ^[0-9]+$ ]]; then printf -v "$1" '%s' ""
  elif (( $2 >= 80 )); then printf -v "$1" '%s' "$T_R"
  elif (( $2 >= 50 )); then printf -v "$1" '%s' "$T_Y"
  else printf -v "$1" '%s' "$T_G"; fi
}

# top_frame: one screen: the personas, then the panes running their CLIs.
top_frame() {
  local now hms name rest fl sl c cli st lc panes i a b lab ctx c5 c7 cpu mem grok=0
  local id wp sess ver ts model used size pct five week cost seen
  local -A cpus=() mems=() count=()
  local -a prow=($'PERSONA\tSTATE\tCPU\tMEM\tPANES') srow=($'PERSONA\tSESSION\tMODEL\tCONTEXT\t5H\t7D\tCOST\tSEEN') rows=()
  local -a lines=() run=()
  local max pl pw=0
  printf -v now '%(%s)T' -1
  printf -v hms '%(%H:%M:%S)T' "$now"
  echo "${T_B}nexus top${T_0}  ${HOSTNAME:-}  $hms${T_EVERY:+  ${T_D}every ${T_EVERY}s, q quits, any other key redraws${T_0}}"
  echo
  # The personas, their containers' states, and the CPU and memory of the running ones (one docker stats).
  mapfile -t lines < <(sed -n 's/\r$//; s/^# persona: //p' "$PERSONAS_FILE")
  ps_states
  for pl in "${lines[@]}"; do
    name="${pl%% *}"; (( ${#name} <= pw )) || pw=${#name}
    [[ -z "${UP[agent-$name]:-}" ]] || run+=("agent-$name")
  done
  if (( ${#run[@]} )); then
    while IFS=$'\t' read -r c cpu mem; do cpus[$c]="$cpu" mems[$c]="${mem%% /*}"; done \
      < <(timeout 20 docker stats --no-stream --format '{{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}' "${run[@]}" 2>/dev/null)
  fi
  # A pane's row fits 79 columns: persona and session label share 26 (the label at least 8), and the rest
  # of the row is at most 53.
  max=$(( pw > 18 ? 8 : 26 - pw ))

  for pl in "${lines[@]}"; do
    name="${pl%% *}" rest="${pl#"$name"}"
    rest=" $rest "
    fl="${rest#* flavour=}"; fl="${fl%% *}"; sl="${rest#* statusline=}"; sl="${sl%% *}"
    c="agent-$name"; cli="${CLI_CMD[$fl]:-$fl}"; st="${STATE[$c]:-not started}"; state_colour lc "$st"
    if [[ -z "${UP[$c]:-}" ]]; then prow+=("$T_B$name$T_0"$'\t'"$lc$st$T_0"$'\t-\t-\t-'); continue; fi

    # Its panes running the CLI. A session with more than one is shown per pane, as session:window.pane.
    rows=() count=()
    while IFS= read -r i; do
      sess="${i#*$'\t'*$'\t'}"; sess="${sess%%$'\t'*}"
      rows+=("$i"); count[$sess]=$(( ${count[$sess]:-0} + 1 ))
    done < <(timeout 10 docker exec "$c" sh -c "$TOP_PROBE" sh "$cli" 2>/dev/null)   # a hung persona can't hang this
    if (( ${#rows[@]} )); then panes="${#rows[@]} $cli"; else panes="${T_D}no $cli running$T_0"; fi
    if [[ "$sl" != yes ]]; then panes+="${T_D}, statusline off$T_0"; fi
    t_clean cpu "${cpus[$c]:-}"; t_clean mem "${mems[$c]:-}"
    prow+=("$T_B$name$T_0"$'\t'"$lc$st$T_0"$'\t'"$cpu"$'\t'"$mem"$'\t'"$panes")
    # What a persona sends is printed, never evaluated: numbers are checked before any arithmetic, and
    # control characters dropped, so a pane can't drive this terminal.
    for i in "${rows[@]}"; do
      IFS=$'\t' read -r id wp sess ver ts model used size pct five week cost <<< "$i"
      a="${count[$sess]}"
      sess="${sess//[[:cntrl:]]/}"; wp="${wp//[^0-9.]/}"
      lab=""
      if (( a > 1 )); then lab=":$wp"; fi
      if (( ${#sess} + ${#lab} > max )); then sess="${sess:0:max-1-${#lab}}~"; fi
      t_clean lab "$sess$lab"
      if [[ "$fl" == grok ]]; then grok=1; fi
      if [[ "$ver" != v1 || ! "$ts" =~ ^[0-9]+$ ]]; then
        srow+=("$name"$'\t'"$lab"$'\t'"$cli"$'\t-\t-\t-\t-\t-')
        continue
      fi
      # Each figure on its own: one the CLI didn't send is "-", and the rest still show.
      t_clean model "${model:0:11}"
      ctx=- lc=""
      if [[ "$used$size" =~ ^[0-9]+$ && "$used" =~ ^[0-9]+$ && "$size" =~ ^[1-9][0-9]*$ ]]; then
        top_tok a "$used"; top_tok b "$size"; ctx="$a/$b"; top_load lc "$pct"
      fi
      top_load c5 "$five"; top_load c7 "$week"
      if [[ "$five" =~ ^[0-9]+$ ]]; then five="$five%"; else five=-; fi
      if [[ "$week" =~ ^[0-9]+$ ]]; then week="$week%"; else week=-; fi
      if [[ "$cost" =~ ^[0-9]+\.[0-9]{4}$ ]]; then   # to the cent, rounded as the statusline does: 3.2049 -> $3.20
        a=$(( (10#${cost/./} + 50) / 100 )); printf -v cost '$%d.%02d' $(( a / 100 )) $(( a % 100 ))
      else
        cost=-
      fi
      top_age seen $(( now - ts ))
      srow+=("$name"$'\t'"$lab"$'\t'"$model"$'\t'"$lc$ctx$T_0"$'\t'"$c5$five$T_0"$'\t'"$c7$week$T_0"$'\t'"$cost"$'\t'"$seen")
    done
  done

  table llrrl "${prow[@]}"
  echo
  if (( ${#srow[@]} == 1 )); then echo "${T_D}no Claude Code or grok pane in a running persona${T_0}"; return; fi
  table lllrrrrr "${srow[@]}"
  echo
  echo "${T_D}CONTEXT used/size; 5H, 7D: the plan's limits used; COST: the session's, at API prices${T_0}"
  echo "${T_D}SEEN: since the CLI last drew its statusline, which it does as the session works${T_0}"
  if (( grok )); then echo "${T_D}grok sends no plan limits (5H, 7D), and a cost only once the session has a price${T_0}"; fi
}

cmd_top() {
  local every=5 once=0 rc k frame
  while (( $# )); do
    case "$1" in
      -n|--interval) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || die "top: $1 takes whole seconds, e.g. $1 10"; every="$2"; shift ;;
      --once)        once=1 ;;
      *)             die "top: unknown argument '$1'; it takes [-n SECONDS] [--once]" ;;
    esac
    shift
  done
  [[ -f "$PERSONAS_FILE" ]] || die "no personas set up yet: run $AGENTS_DIR/config.sh"
  set_colours
  if (( once )) || [[ ! -t 1 ]]; then top_frame; return; fi

  # As top: the alternate screen, no cursor, and rows cut at the right edge rather than wrapped.
  T_EVERY="$every"
  trap 'printf "\033[?7h\033[?25h\033[?1049l"' EXIT
  trap 'exit 0' INT TERM HUP
  printf '\033[?1049h\033[?25l\033[?7l'
  while :; do
    frame="$(top_frame 2>&1)" || true
    printf '\033[H%s\033[K\033[J' "${frame//$'\n'/$'\033[K\n'}"
    if [[ ! -t 0 ]]; then sleep "$every"; continue; fi
    rc=0; read -rsn1 -t "$every" k || rc=$?
    if (( rc == 0 )) && [[ "$k" == [qQ] ]]; then break; fi
    (( rc == 0 || rc > 128 )) || break   # end of input: no q can come any more
  done
}

persona="$1"; shift
[[ "$persona" == ls ]] && { cmd_ls_all; exit 0; }
[[ "$persona" == top ]] && { cmd_top "$@"; exit 0; }

[[ -f "$PERSONAS_FILE" ]] || die "no personas set up yet: run $AGENTS_DIR/config.sh"
[[ "$persona" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "not a persona name: '$persona'"
meta=" $(sed -n "s/\r\$//; s/^# persona: $persona //p" "$PERSONAS_FILE" | head -n 1) "   # CRLF-safe, as config.sh
[[ "$meta" != "  " ]] \
  || die "no persona '$persona' (set up: $(sed -n 's/^# persona: \([^ ]*\).*/\1/p' "$PERSONAS_FILE" | paste -sd ' ')); add it with $AGENTS_DIR/config.sh"

meta_get() { local v="${meta#* "$1"=}"; [[ "$v" == "$meta" ]] || echo "${v%% *}"; }
root="$(meta_get root)"; root="${root:-$vm_root}"; root="${root%/}"
COMPOSE=(env "PROJECTS_ROOT=$root" "${COMPOSE[@]}")

service="$persona"
container="agent-$persona"

# Management subcommands. None of them mounts the ssh-agent, so a placeholder keeps compose.yml's
# required-variable check from blocking e.g. a build on a VM without one.
mgmt() { export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-/dev/null}"; exec "${COMPOSE[@]}" --profile "$persona" "$@"; }
running() { [[ "$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null || true)" == true ]]; }

# --- headless --------------------------------------------------------------------------------------
# nexus <persona> headless [PROMPT] [FLAGS…]: one prompt through the persona's CLI in its one-shot mode,
# in this directory, without tmux; the CLI's stdout, stderr and exit code are this command's. PROMPT is
# the first argument unless that is a flag (-x, --opt or --opt=value), so a task file may start with
# "---". Input piped or redirected in goes with it, after the prompt as `claude -p` takes it; without a
# PROMPT it is the prompt. Only then does docker exec get -i: given a terminal, the CLI would wait for it.

# headless_argv FLAVOUR PROMPT PIPED FLAGS…: the CLI's command line in H_ARGV, and in H_FEED a prompt
# to send ahead of the piped input (for a CLI that ignores that input next to a prompt). The prompt goes
# where the CLI can't take it for an option. Another flavour is one more entry.
H_ARGV=() H_FEED=""
headless_argv() {
  local fl="$1" prompt="$2" piped="$3"; shift 3
  H_FEED=""
  case "$fl" in
    claude) H_ARGV=(claude -p "$@")
            if [[ -n "$prompt" ]]; then H_ARGV+=(-- "$prompt"); fi ;;
    grok)   if (( piped )); then H_ARGV=(grok --prompt-file /dev/stdin "$@"); H_FEED="$prompt"
            else H_ARGV=(grok "--single=$prompt" "$@"); fi ;;
    *)      return 1 ;;
  esac
}

# docker exec doesn't pass signals on, and its client runs in a session of its own (setsid), so Ctrl-C
# or a timeout's TERM reach nexus only. hl_signal SIG sends SIG on, inside the persona, to the CLI's
# process group, as a terminal's Ctrl-C would: the CLI is the marked process docker exec started (parent
# 0), and daemons the run detached, in groups of their own, are left alone. The kill goes first, and its
# own setsid keeps a second Ctrl-C from cancelling it; the notice after it can't fail.
HL_RUN="" HL_SIG="" HL_SPOOL=""
hl_signal() {
  local notice=""
  [[ -n "$HL_SIG" ]] || notice=1
  HL_SIG="$1"
  trap '' PIPE   # a stderr reader that died of the same Ctrl-C mustn't end nexus here
  # shellcheck disable=SC2016  # expanded by sh inside the persona
  setsid docker exec "$container" sh -c 'for f in $(grep -lsxz "NEXUS_RUN=$1" /proc/[0-9]*/environ); do
      p="${f#/proc/}"; p="${p%/environ}"
      while read -r k v; do if [ "$k" = PPid: ] && [ "$v" = 0 ]; then kill -"$2" "-$p"; fi; done < "/proc/$p/status"
    done 2>/dev/null' sh "$HL_RUN" "$1" >/dev/null 2>&1 || true
  if [[ -n "$notice" ]]; then { echo "nexus: $1: stopping the run in $persona" >&3; } 3>&2 2>/dev/null || true; fi
}

cmd_headless() {
  local flavour prompt="" piped=0 first="" pid rc
  local -a dx
  flavour="$(meta_get flavour)"
  [[ "${1:-}" != -- ]] || shift
  if (( $# )) && [[ ! "$1" =~ ^-[^[:space:]=]*(=.*)?$ ]]; then prompt="$1"; shift; fi
  if [[ -p /dev/stdin || -f /dev/stdin || -S /dev/stdin ]]; then piped=1; fi   # a socket: Node's child_process
  [[ -n "$prompt" ]] || (( piped )) \
    || die "headless: give the prompt first, e.g. nexus $persona headless \"list the TODOs\" --output-format json; or pipe it in"
  # Next to a PROMPT the input is extra: from a pipe or socket it counts if it starts within 3 s, as
  # claude -p decides for itself, so a caller that leaves stdin open doesn't hold the run. Without one,
  # the input is the prompt and is waited for.
  if (( piped )) && [[ -n "$prompt" && ! -f /dev/stdin ]]; then
    rc=0; IFS= read -r -t 3 -N 1 first || rc=$?
    if (( rc > 128 )); then
      warn "headless: no input on stdin within 3 s, so running without it (</dev/null skips the wait)"; piped=0
    elif (( rc )); then
      piped=0   # it ended at once: nothing piped
    fi
  fi
  headless_argv "$flavour" "$prompt" "$piped" "$@" || die "headless: no one-shot mode known for $persona's flavour '$flavour'"

  # Piped input is read to its end first, into a file the CLI then reads at once (H_FEED goes ahead of it).
  if (( piped )); then
    HL_SPOOL="$(mktemp)" || die "headless: can't make a temp file for the input"
    trap 'rm -f -- "$HL_SPOOL"' EXIT
    { if [[ -n "$H_FEED" ]]; then printf '%s\n' "$H_FEED"; fi; printf '%s' "$first"; cat; } > "$HL_SPOOL"
    exec < "$HL_SPOOL"
    rm -f -- "$HL_SPOOL"; trap - EXIT
    [[ -n "$prompt" || -s /dev/stdin ]] || die "headless: no prompt, and the input piped in was empty"
  fi

  HL_RUN="nexus-$$-$RANDOM$RANDOM"
  dx=(setsid -w docker exec -e "NEXUS_RUN=$HL_RUN" -w "$dir")
  if (( piped )); then dx+=(-i); fi
  trap 'hl_signal INT' INT
  trap 'hl_signal TERM' TERM HUP
  # In the background, so the traps run while it does; <&0, or a background job reads /dev/null.
  "${dx[@]}" "$container" "${H_ARGV[@]}" <&0 &
  pid=$!
  while :; do
    rc=0; wait "$pid" || rc=$?
    kill -0 "$pid" 2>/dev/null || break   # a trapped signal ends wait early; the CLI may still be stopping
  done
  trap - INT TERM HUP
  # Interrupted: say so in the exit code, whatever the CLI returned (claude -p exits 0 on SIGINT).
  case "$HL_SIG" in INT) exit 130 ;; TERM) exit 143 ;; esac
  exit "$rc"
}

# --- upgrade ---------------------------------------------------------------------------------------
# compose_q PERSONA ARGS…: compose for that persona; nothing here mounts the ssh-agent, so the socket may
# be a placeholder, as in mgmt.
compose_q()   { local p="$1"; shift; SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-/dev/null}" "${COMPOSE[@]}" --profile "$p" "$@"; }
image_ref()   { compose_q "$1" config --images "$1"; }
image_id()    { docker image inspect -f '{{.Id}}' "$1" 2>/dev/null; }
cli_version() { docker run --rm --network none "$1" "$cli" --version 2>/dev/null | head -n 1 || true; }

# What a failed or interrupted upgrade puts back: the pin, and each image tag the run built. A tag that
# existed before (a fixed *_TAG, or a version built earlier) points at its old image again; a new one goes.
UP_PIN="" UP_OLD="" UP_REFS=()
declare -A UP_PRE=()
up_restore() {
  local r
  env_set "$UP_PIN" "$UP_OLD" || warn "couldn't put $UP_PIN=$UP_OLD back into $AGENTS_DIR/.env: set it by hand"
  for r in "${UP_REFS[@]}"; do
    if [[ -n "${UP_PRE[$r]}" ]]; then
      [[ "$(image_id "$r" || true)" == "${UP_PRE[$r]}" ]] || docker tag "${UP_PRE[$r]}" "$r" \
        || warn "couldn't point $r back at its old image ${UP_PRE[$r]:7:12}"
    else
      docker image rm "$r" >/dev/null 2>&1 || true
    fi
  done
}
cmd_upgrade() {
  local want="" yes=0 a need
  for a in "$@"; do
    case "$a" in
      -y|--yes) yes=1 ;;
      -*)       die "upgrade: unknown option '$a'" ;;
      *)        [[ -z "$want" ]] || die "upgrade takes one VERSION or CHANNEL, not '$want $a'"; want="$a" ;;
    esac
  done
  local flavour; flavour="$(meta_get flavour)"
  [[ -n "$flavour" && -n "${CLI_PIN[$flavour]:-}" ]] || die "upgrade: no CLI known for $persona's flavour '$flavour'"
  cli="${CLI_CMD[$flavour]}"
  local pin="${CLI_PIN[$flavour]}" tagvar="${CLI_TAG[$flavour]}" channels="${CLI_CHANNELS[$flavour]}"
  [[ -f "$AGENTS_DIR/.env" ]] || die "no $AGENTS_DIR/.env yet: run $AGENTS_DIR/config.sh"
  ! printenv "$pin" >/dev/null || die "$pin is exported in this shell and beats $AGENTS_DIR/.env: unset it, then upgrade"
  # One upgrade or config.sh at a time per checkout: they share config.sh's lock.
  exec 8< "$AGENTS_DIR/config.sh"
  flock -n 8 || die "config.sh or another upgrade is running in $AGENTS_DIR; let it finish first"

  # The version: the one given, or the newest of a channel.
  local version="${want#v}"
  version="${version:-${channels%% *}}"
  if [[ " $channels " == *" $version "* ]]; then
    local url="${CLI_NEWEST[$flavour]//\{channel\}/$version}"
    version="$(curl -fsSL --max-time 20 "$url" | tr -d '[:space:]')" || die "can't look up the newest $cli at $url"
    [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9._]+)?$ ]] || die "$url gave '$version', not a version"
  elif [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9._]+)?$ ]]; then
    die "upgrade: '$want' is neither a version (X.Y.Z) nor a channel of $cli ($channels)"
  fi

  # The pin is VM-wide, so this covers every persona of the flavour: one image per context, built once
  # (via its first persona). What they and their image names run now:
  local name rest ctx id r was=""
  local -a peers=() builders=() olds=()
  local -A seen=() ref_new=() id_new=() own=()
  while read -r _ _ name rest; do
    [[ " $rest " == *" flavour=$flavour "* ]] || continue
    peers+=("$name")
    [[ " $rest" != *" ssh="* ]] || own[$name]=1   # an ssh key of its own, or none: starts without your agent
    ctx="${rest#*context=}"; ctx="${ctx%% *}"
    if [[ -z "${seen[${ctx:-none}]:-}" ]]; then seen[${ctx:-none}]=1; builders+=("$name"); fi
  done < <(grep '^# persona: ' "$PERSONAS_FILE")
  for name in "${peers[@]}"; do
    r="$(image_ref "$name")" || die "compose can't resolve $name's image (see above)"
    if id="$(image_id "$r")"; then olds+=("$id"); was="${was:-$(cli_version "$r")}"; fi
    if id="$(docker inspect -f '{{.Image}}' "agent-$name" 2>/dev/null)"; then olds+=("$id"); fi
  done
  UP_PIN="$pin" UP_OLD="$(env_get "$pin")"
  UP_OLD="${UP_OLD:-latest}"   # no pin yet meant latest, compose's default
  echo "nexus: $cli for ${peers[*]}: ${was:-$UP_OLD} -> $version"

  # Pin it, then build or pull each image. A failure or Ctrl-C puts the old pin back (only the pin:
  # the rest of .env is left alone).
  trap 'up_restore; exit 130' INT TERM HUP
  env_set "$pin" "$version" || die "can't write $AGENTS_DIR/.env"
  for name in "${builders[@]}"; do
    r="$(image_ref "$name")" || { up_restore; die "compose can't resolve $name's image (see above); $pin is back to $UP_OLD"; }
    UP_REFS+=("$r"); UP_PRE[$r]="$(image_id "$r" || true)"
  done
  local registry="${REGISTRY:-$(env_get REGISTRY)}" verb=build
  [[ "${registry:-local}" == local ]] || verb=pull
  for name in "${builders[@]}"; do
    if [[ $verb == build ]]; then compose_q "$name" build "$name"; else compose_q "$name" pull --policy always "$name"; fi \
      || { up_restore; die "the $verb for $name failed (see above); $pin is back to $UP_OLD"; }
  done
  # Each image must really have that version: with a fixed tag, or a registry image that isn't that
  # version, .env would name a version nothing runs.
  local tag="${!tagvar:-$(env_get "$tagvar")}" now="" n
  for name in "${peers[@]}"; do
    if ! r="$(image_ref "$name")" || ! id="$(image_id "$r")"; then
      up_restore; die "no image for $name after the $verb; $pin is back to $UP_OLD"
    fi
    ref_new[$name]="$r" id_new[$name]="$id"
  done
  for name in "${builders[@]}"; do
    n="$(cli_version "${ref_new[$name]}")"
    if [[ " $n " != *" $version "* ]]; then
      up_restore
      [[ -n "$n" ]] || die "\`$cli --version\` prints nothing in ${ref_new[$name]} (try: docker run --rm ${ref_new[$name]} $cli --version); $pin is back to $UP_OLD"
      die "${ref_new[$name]} has $n, not $version${tag:+ (it is tagged by $tagvar=$tag, not the version)}; $pin is back to $UP_OLD"
    fi
    now="${now:-$n}"
  done
  trap - INT TERM HUP
  echo "nexus: $pin=$version in $AGENTS_DIR/.env; ${now:-$cli $version} in: $(for name in "${builders[@]}"; do printf '%s ' "${ref_new[$name]}"; done)"
  r="${ref_new[${builders[0]}]}"
  if [[ "${r##*:}" != "$version" ]]; then
    if [[ -z "$tag" || ( "$flavour" == grok && "$tag" == latest ) ]]; then   # a personas file or .env from before upgrade
      warn "$r is still tagged ${r##*:}: re-run $AGENTS_DIR/config.sh once, and the tags follow $pin from then on"
    elif [[ "$tag" == latest ]]; then
      warn "$r is tagged by $tagvar=latest in $AGENTS_DIR/.env, not by the version: remove that line, and the tags follow $pin"
    fi
  fi

  # Containers still on an older image. A stopped one is removed: its next start creates it anew.
  local -a run=() later=() failed=() gone=() kept=()
  for name in "${peers[@]}"; do
    id="$(docker inspect -f '{{.Image}}' "agent-$name" 2>/dev/null)" || continue
    [[ "$id" != "${id_new[$name]}" ]] || continue
    if [[ "$(docker inspect -f '{{.State.Running}}' "agent-$name")" == true ]]; then
      run+=("$name")
    elif docker rm "agent-$name" >/dev/null; then
      echo "nexus: removed the stopped agent-$name; its next start uses the new image"
    fi
  done
  if (( ${#run[@]} )); then
    echo "nexus: still on the old image, so recreating ends their tmux sessions (and the $cli in them):"
    for name in "${run[@]}"; do
      a="$(docker exec "agent-$name" tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -vx main | paste -sd ' ' - || true)"
      echo "  $name${a:+  (sessions: $a)}"
    done
    a=y need=""
    for name in "${run[@]}"; do [[ -n "${own[$name]:-}" ]] || need="${need:+$need }$name"; done
    if [[ -n "$need" && ! -S "${SSH_AUTH_SOCK:-}" ]]; then
      echo "nexus: but recreating $need needs an ssh-agent, and this shell has none"; a=n
    elif (( ! yes )); then
      a=n
      if [[ -t 0 ]]; then read -r -p "Recreate them now? [y/N] " a || a=n; fi
    fi
    if [[ "$a" == [yY]* ]]; then
      # Through the launcher, so each gets its own context's preflight (ddev dirs, mkcert CA).
      for name in "${run[@]}"; do
        "$AGENTS_DIR/nexus" "$name" restart 8<&- || failed+=("$name")
      done
    else
      later=("${run[@]}")
    fi
  fi

  # The old images, unless a container still uses them: their tags under these images' names, or the
  # image itself if a rebuild left it without one.
  local -A new_ids=() repos=()
  for name in "${peers[@]}"; do new_ids[${id_new[$name]}]=1; repos[${ref_new[$name]%:*}]=1; done
  local t tags
  for id in $(printf '%s\n' "${olds[@]}" | sort -u); do
    [[ -z "${new_ids[$id]:-}" ]] || continue
    tags="$(docker image inspect -f '{{range .RepoTags}}{{.}} {{end}}' "$id" 2>/dev/null)" || continue
    if [[ -z "${tags// /}" ]]; then
      if docker image rm "$id" >/dev/null 2>&1; then gone+=("${id:7:12}"); else kept+=("${id:7:12}"); fi
      continue
    fi
    for t in $tags; do
      [[ -n "${repos[${t%:*}]:-}" ]] || continue
      if docker image rm "$t" >/dev/null 2>&1; then gone+=("$t"); else kept+=("$t"); fi
    done
  done
  (( ${#gone[@]} )) && echo "nexus: removed the old image: ${gone[*]}"
  (( ${#kept[@]} )) && echo "nexus: kept the old image (a container still uses it): ${kept[*]}"
  if (( ${#failed[@]} )); then
    echo "nexus: recreating ${failed[*]} failed (see above); once that's fixed:$(printf ' nexus %s restart;' "${failed[@]}")" >&2
    exit 1
  fi
  if (( ${#later[@]} )); then
    echo "nexus: not recreated: ${later[*]}. When they're idle, \`nexus $persona upgrade $version\` recreates them and removes the old image"
  else
    echo "nexus: done; ${peers[*]} run ${now:-$cli $version}"
  fi
}

restart=0 start_only=0 upgrade=0 up_args=() headless=0
case "${1:-}" in
  ls)      running || die "$persona isn't running; start it with: nexus $persona"
           set_colours; SROWS=($'SESSION\tWINDOWS\tATTACHED\tDIR')
           sess_rows "$container" "" || die "tmux in $persona isn't answering; try again, or nexus $persona restart"
           table lrll "${SROWS[@]}"; exit 0 ;;
  start)   start_only=1 ;;
  stop)    shift; mgmt stop "$@" "$service" ;;
  logs)    shift; mgmt logs -f "$@" "$service" ;;
  build)   shift; mgmt build "$@" "$service" ;;
  pull)    shift; mgmt pull --policy always "$@" "$service" ;;   # compose.yml never pulls on its own
  restart) restart=1 ;;
  upgrade) shift; upgrade=1 up_args=("$@") ;;
  headless) shift; headless=1 ;;
esac

# Preflight: mount sources must exist, or Docker creates them root-owned.
if [[ -n "$(meta_get root)" ]]; then where="$persona's own, in $PERSONAS_FILE; change it with config.sh"
else where="PROJECTS_ROOT from your shell or $AGENTS_DIR/.env; fix it, or unset it for ~/projects"; fi
[[ "$root" == /?* ]] || die "the projects root must be an absolute path, not '$root' ($where)"
mkdir -p "$root" 2>/dev/null || die "can't create the projects root $root ($where)"
# Context "ddev": the VM's ~/.ddev and mkcert CA are mounted, and the CA is trusted inside if it exists.
no_ca=0
if [[ "$meta" == *" context=ddev "* ]]; then
  mkdir -p "$HOME/.ddev" "$HOME/.local/share/mkcert"
  if [[ -f "$HOME/.local/share/mkcert/rootCA.pem" ]]; then
    export AGENT_CA_CERTS="$HOME/.local/share/mkcert/rootCA.pem"
  else
    export AGENT_CA_CERTS=""; no_ca=1
  fi
fi
# ssh= in its "# persona:" line (set by config.sh): instead of your agent, an ssh key of its own (its path)
# or no ssh at all (none). Its compose service puts /dev/null where the agent's socket would be, so
# compose.yml's required SSH_AUTH_SOCK only needs a value here.
own_ssh="$(meta_get ssh)" key=""
if [[ -n "$own_ssh" ]]; then
  if [[ "$own_ssh" != none ]]; then key="$own_ssh"; [[ "$key" == /* ]] || key="$AGENTS_DIR/$key"; fi
  export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-/dev/null}"
fi
(( upgrade )) && { cmd_upgrade "${up_args[@]}"; exit 0; }

# (Re)create the persona container if asked or if it isn't running. Its ssh-agent socket path is
# fixed at creation, for the container's whole life (a new path makes compose recreate it).
if (( restart )) || ! running; then
  # A missing key would become a root-owned directory (Docker); a running persona has its key mounted already.
  [[ -z "$key" || ( -f "$key" && -r "$key" ) ]] \
    || die "$persona's ssh key $key isn't there; config.sh makes one (SSH: new), or points it at another, none or your agent"
  # So would the statusline paths a personas file from before statusline/ was split into claude/ and
  # grok/ still names.
  if grep -qE '\./statusline(:|/settings\.json:)' "$PERSONAS_FILE"; then
    die "$PERSONAS_FILE is from before statusline/ was split into claude/ and grok/: re-run $AGENTS_DIR/config.sh (--yes keeps every setting), then start $persona again"
  fi
  # So would the settings files a persona's service mounts: personas/claude.json (committed) and a grok
  # persona's managed config, which config.sh writes.
  if grep -qF "./personas/claude.json," "$PERSONAS_FILE" && [[ "$meta" == *" flavour=claude "* && ! -f "$AGENTS_DIR/personas/claude.json" ]]; then
    die "$AGENTS_DIR/personas/claude.json isn't there: restore it (git checkout personas/claude.json), or re-run $AGENTS_DIR/config.sh without it"
  fi
  if grep -qF "./personas/$persona.grok.toml," "$PERSONAS_FILE" && [[ ! -f "$AGENTS_DIR/personas/$persona.grok.toml" ]]; then
    die "$AGENTS_DIR/personas/$persona.grok.toml isn't there: re-run $AGENTS_DIR/config.sh, which writes it"
  fi
  if (( no_ca )); then
    warn "no mkcert CA on this VM yet — run 'mkcert -install' here, then \`nexus $persona restart\`, or https://*.ddev.site stays untrusted inside"
  fi
  if [[ -z "$own_ssh" && -S "$SSH_AUTH_SOCK" ]] && command -v ssh-add >/dev/null; then
    rc=0; ssh-add -l >/dev/null 2>&1 || rc=$?
    case $rc in
      1) warn "the ssh-agent at $SSH_AUTH_SOCK holds no keys (ssh-add -l); git over ssh will fail inside" ;;
      2) warn "nothing answers at $SSH_AUTH_SOCK (stale ssh-agent socket); git over ssh will fail inside" ;;
    esac
  fi
  (( restart )) && exec "${COMPOSE[@]}" --profile "$persona" up -d --force-recreate "$service"
  "${COMPOSE[@]}" --profile "$persona" up -d "$service" >&2   # progress only: a headless run's stdout is the CLI's
fi
(( start_only )) && exit 0

dir="$here"
case "$dir/" in
  "$root"/*) [[ -d "$dir" ]] || die "$dir no longer exists; cd to a project dir" ;;
  *) # The same place by another path (a symlink on either side)? Then the root's spelling of it: that is
     # the path mounted inside. Truly outside: a session starts in the root, a headless run refuses.
     rr="$(realpath -e -- "$root" 2>/dev/null || true)" rh="$(realpath -e -- "$here" 2>/dev/null || true)"
     if [[ -n "$rr" && -n "$rh" && "$rh/" == "$rr"/* ]]; then
       dir="$root${rh#"$rr"}"
     elif (( headless )); then
       die "headless: $here is outside $persona's projects root ($root); cd to a project in it"
     else
       echo "nexus: $here is outside $persona's projects root; starting in $root" >&2; dir="$root"
     fi ;;
esac
(( headless )) && cmd_headless "$@"

# Session name + command.
session=""; cmd=()
if [[ $# -gt 0 && "$1" != "--" ]]; then session="$1"; shift; fi
if [[ "${1:-}" == "--" ]]; then shift; cmd=("$@"); fi
session="${session:-$(basename "$dir")}"
session="${session//[.:]/_}"   # tmux rewrites '.' and ':' in session names; do the same up front

# tmux inside needs terminfo for $TERM; terminals the image doesn't know (kitty, ghostty) get a safe one.
term="${TERM:-xterm-256color}"
docker exec "$container" infocmp "$term" >/dev/null 2>&1 || term=xterm-256color

# -A: attach if the session exists, else create it (cmd is only used on create).
exec docker exec -it -e TERM="$term" -w "$dir" "$container" \
  tmux new-session -A -s "$session" -c "$dir" "${cmd[@]}"
