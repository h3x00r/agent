#!/usr/bin/env bash
# nexus — the launcher for persona containers (`nexus --help` says what it takes). The work is done in
# Python (agentctl/, Python 3.8 or newer, nothing else to install). This script finds it next to itself,
# through the /usr/local/bin symlink too (or in $AGENTS_DIR, for a copy of it elsewhere), and hands over.
self="$(readlink -f -- "$0")" || { echo "nexus: can't tell where $0 is" >&2; exit 1; }
code="${self%/*}"
[[ -f "$code/agentctl/_boot.py" ]] || code="${AGENTS_DIR:-$code}"
if [[ ! -f "$code/agentctl/_boot.py" ]]; then
  echo "nexus: no agentctl/ next to $self: link it into your PATH (nexus --config does) rather than copy it," \
       "or set AGENTS_DIR to the checkout" >&2
  exit 1
fi
if ! python3 -I -c 'import sys; sys.exit(sys.version_info < (3, 8))' 2>/dev/null; then
  p=nexus; [[ ${1-} == --config ]] && p=config   # the setup tool's messages start config:
  echo "$p: needs Python 3.8 or newer; python3 here is $(python3 --version 2>&1 || echo missing)" >&2
  exit 1
fi
# Python takes a C locale for C.UTF-8 and exports that to its children (PEP 538), and judges a locale that
# isn't installed by its name; bash did neither. So this says what bash made of the locale (whether é is one
# character) and what LC_CTYPE was, and the Python measures text by the one and passes the other on.
u=$'\xc3\xa9'
export AGENTCTL_LOCALE="$(( ${#u} == 1 ))${LC_CTYPE+:$LC_CTYPE}"
exec python3 -I -B -S "$code/agentctl/_boot.py" nexus "$@"
