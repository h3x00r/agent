#!/bin/sh
# tests/fake-grok — grok as far as tests/run.sh needs it, on the PATH of its grok persona.
#
# Prints the arguments nexus gave it, the directory it runs in and, given --prompt-file, that file's
# content with its newlines as "|"; then "rules: BYTES FIRST-LINE" for a --rules=TEXT argument (the grok shim's,
# grok-mode.sh, which run.sh puts in front of it as grok) or "rules: none", and "wrapped: $NEXUS_WRAPPED" (or
# "wrapped: none"). Then, by prompt: "exit N" exits N; "hold NAME" waits five minutes,
# its pid in $NXT_STATE/NAME.pid; "daemon NAME" does the same after detaching a daemon of its own, as an
# agent's dev server would be, with that daemon's pid in $NXT_STATE/NAME.daemon.
state="${NXT_STATE:-/tmp}" prompt="" file=0 rules="" hasrules=0 nl='
'
printf 'argv:'
for a in "$@"; do printf ' [%s]' "$a"; done
printf '\npwd: %s\n' "$PWD"
for a in "$@"; do
  if [ "$file" = 1 ]; then
    in="$(cat -- "$a"; echo .)"; in="${in%.}"
    printf 'stdin: %s\n' "$(printf '%s' "$in" | tr '\n' '|')"
    prompt="${in%%"$nl"*}" file=0
  fi
  case "$a" in
    --single=*)    prompt="${a#--single=}" ;;
    --prompt-file) file=1 ;;
    --rules=*)     rules="${a#--rules=}" hasrules=1 ;;
  esac
done
if [ "$hasrules" = 1 ]; then
  printf 'rules: %s %s\n' "$(printf '%s' "$rules" | wc -c | tr -d ' ')" "${rules%%"$nl"*}"
else
  echo 'rules: none'
fi
printf 'wrapped: %s\n' "${NEXUS_WRAPPED:-none}"

case "$prompt" in
  "exit "*)   exit "${prompt#exit }" ;;
  "hold "*)   echo "$$" > "$state/${prompt#hold }.pid"; exec sleep 300 ;;
  "daemon "*) n="${prompt#daemon }"
              # shellcheck disable=SC2016  # $$ there is the daemon's own
              setsid sh -c 'echo "$$" > "$1"; exec sleep 300' sh "$state/$n.daemon" </dev/null >/dev/null 2>&1 &
              echo "$$" > "$state/$n.pid"; exec sleep 300 ;;
esac
