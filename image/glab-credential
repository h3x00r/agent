#!/bin/sh
# git's credential helper for GitLab over https, in front of glab's (`glab auth git-credential`).
# /usr/local/libexec/nexus/glab-credential in the persona images; /etc/gitconfig names it for https://gitlab.com, and
# a persona can name it for its own GitLab too: git config --global credential.https://<host>.helper <this file>.
#
# glab sends an env token (GITLAB_TOKEN, GITLAB_ACCESS_TOKEN, OAUTH_TOKEN) to the host it designates, and also to
# every host in its config file, gitlab.com always among them. So a self-managed GitLab's token would go to
# gitlab.com on any 401 there, and a gitlab.com token to a second GitLab that `glab auth login` added. Here the env
# token goes only where git asks for the host glab designates (`glab config get host`: GITLAB_HOST, GITLAB_URI or
# GL_HOST, else the config's host key, gitlab.com unless set). For any other host glab runs without it and answers
# with what `glab auth login --hostname <host>` stored, or nothing (git then goes on to its next helper, or its
# prompt; a line here names the host the env token is for). Hosts compare as glab writes them, port included, in
# lower case.
#
# git's request is read whole (git closes stdin after it), and handed on as it was: get, store and erase alike.
# NEXUS_GLAB: the glab to run (tests/unit/test_glab_credential.py runs a stand-in).
glab="${NEXUS_GLAB:-/usr/local/bin/glab}"

req="$(cat)"
asked=
while IFS= read -r line; do
  case $line in host=*) asked="${line#host=}"; break ;; esac
done <<EOF
$req
EOF

# </dev/null: git's request is read above; glab's lookup gets nothing of it.
want="$("$glab" config get host </dev/null 2>/dev/null)"
want="${want#*://}"; want="${want%%/*}"
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

if [ -n "$asked" ] && [ "$(lower "$asked")" = "$(lower "$want")" ]; then
  printf '%s\n' "$req" | "$glab" auth git-credential "$@"
else
  printf '%s\n' "$req" | env -u GITLAB_TOKEN -u GITLAB_ACCESS_TOKEN -u OAUTH_TOKEN "$glab" auth git-credential "$@"
  rc=$?
  # glab, without the token, says nothing: git's own error (no username) would leave the token's host unsaid.
  if [ "$rc" != 0 ] && [ "${1-}" = get ] && [ -n "$asked" ] \
     && [ -n "${GITLAB_TOKEN:-${GITLAB_ACCESS_TOKEN:-${OAUTH_TOKEN:-}}}" ]; then
    echo "glab-credential: the GitLab token in the environment is for ${want:-another host}, so $asked doesn't" \
         "get it (a login of its own: glab auth login --hostname $asked)" >&2
  fi
  exit "$rc"
fi
